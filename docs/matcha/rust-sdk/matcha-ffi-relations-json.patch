+/// Matcha fork: one page of related events as raw JSON, see
+/// [`Room::fetch_relations_json`].
+#[derive(uniffi::Record)]
+pub struct RelationsJsonPage {
+    /// The raw JSON of each related event, newest first.
+    pub events: Vec<String>,
+    /// The token for the next (older) page, or `None` at the end.
+    pub next_batch: Option<String>,
 }
 
